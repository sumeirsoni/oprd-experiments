#!/bin/bash
set -euo pipefail

: "${OPRD_REAL_PYTHON:?OPRD_REAL_PYTHON is required}"

if [[ ${1:-} == -m && ${2:-} == verl.trainer.main_ppo ]]; then
  : "${OPRD_HYDRA_CAPTURE:?OPRD_HYDRA_CAPTURE is required}"
  : "${OPRD_ARGV_CAPTURE:?OPRD_ARGV_CAPTURE is required}"
  : "${OPRD_CONTRACT_TOOL:?OPRD_CONTRACT_TOOL is required}"
  : "${OPRD_CONTRACT:?OPRD_CONTRACT is required}"
  : "${OPRD_OFFICIAL_ROOT:?OPRD_OFFICIAL_ROOT is required}"
  EXPECTED_WORLD_SIZE=${OPRD_EXPECTED_WORLD_SIZE:-8}
  HYDRA_EXECUTION_ARGS=()
  HYDRA_RESUME_ARGS=()
  MAX_ACTOR_CKPTS=
  if [[ -n ${OPRD_EXECUTION_DEVIATION:-} ]]; then
    EXECUTION_JSON=$(
      "$OPRD_REAL_PYTHON" "$OPRD_CONTRACT_TOOL" --contract "$OPRD_CONTRACT" \
        emit-execution --execution "$OPRD_EXECUTION_DEVIATION"
    )
    EXPECTED_WORLD_SIZE=$(
      "$OPRD_REAL_PYTHON" -c \
        'import json,sys; print(json.load(sys.stdin)["effective_topology"]["world_size"])' \
        <<< "$EXECUTION_JSON"
    )
    MAX_ACTOR_CKPTS=$(
      "$OPRD_REAL_PYTHON" -c \
        'import json,sys; print(json.load(sys.stdin)["checkpoint_policy"]["max_actor_checkpoints_to_keep"])' \
        <<< "$EXECUTION_JSON"
    )
    HYDRA_EXECUTION_ARGS=(--execution "$OPRD_EXECUTION_DEVIATION")
  fi
  [[ $EXPECTED_WORLD_SIZE == 4 || $EXPECTED_WORLD_SIZE == 8 ]] || {
    printf 'ERROR: OPRD_EXPECTED_WORLD_SIZE must be 4 or 8\n' >&2
    exit 1
  }
  RUN_ARGS=("$@")
  if [[ -n ${OPRD_RESUME_AUTHORIZATION:-} ]]; then
    [[ $OPRD_RESUME_AUTHORIZATION == task0-7258005 ]] || {
      printf 'ERROR: unknown resume authorization\n' >&2
      exit 1
    }
    : "${OPRD_RESUME_FROM_PATH:?OPRD_RESUME_FROM_PATH is required}"
    : "${OPRD_RESUME_LOCAL_DIR:?OPRD_RESUME_LOCAL_DIR is required}"
    : "${OPRD_RESUME_HYDRA_DIR:?OPRD_RESUME_HYDRA_DIR is required}"
    : "${OPRD_RESUME_MANIFEST:?OPRD_RESUME_MANIFEST is required}"
    : "${OPRD_RESUME_NAMESPACE:?OPRD_RESUME_NAMESPACE is required}"
    : "${OPRD_RESUME_CONTINUATION:?OPRD_RESUME_CONTINUATION is required}"
    : "${OPRD_RESUME_TERMINAL_LOG:?OPRD_RESUME_TERMINAL_LOG is required}"
    : "${PROJECT_PATH:?PROJECT_PATH is required}"
    HYDRA_RESUME_ARGS=(
      --resume "$OPRD_RESUME_MANIFEST"
      --official-namespace "$OPRD_RESUME_NAMESPACE"
      --continuation-dir "$OPRD_RESUME_CONTINUATION"
    )
    [[ $EXPECTED_WORLD_SIZE == 4 && $MAX_ACTOR_CKPTS == 1 ]] || {
      printf 'ERROR: resume authorization requires the four-GPU retention-one execution manifest\n' >&2
      exit 1
    }
    WORLD_SIZE_REPLACEMENTS=0
    DEFAULT_DIR_REPLACEMENTS=0
    OUTPUT_LOG_REPLACEMENTS=0
    for argument in "${RUN_ARGS[@]}"; do
      case $argument in
        trainer.n_gpus_per_node=8) WORLD_SIZE_REPLACEMENTS=$((WORLD_SIZE_REPLACEMENTS + 1)) ;;
        trainer.default_local_dir="$PROJECT_PATH"/*-OPD)
          DEFAULT_DIR_REPLACEMENTS=$((DEFAULT_DIR_REPLACEMENTS + 1))
          ;;
        trainer.output_log_path="$PROJECT_PATH"/logs/terminal/*.log)
          OUTPUT_LOG_REPLACEMENTS=$((OUTPUT_LOG_REPLACEMENTS + 1))
          ;;
        trainer.resume_mode=*|trainer.resume_from_path=*|trainer.default_local_dir=*|trainer.output_log_path=*|trainer.total_training_steps=*|trainer.n_gpus_per_node=*|trainer.max_actor_ckpt_to_keep=*|hydra.run.dir=*)
          printf 'ERROR: caller supplied duplicate, unexpected, or conflicting resume override: %s\n' "$argument" >&2
          exit 1
          ;;
      esac
    done
    [[ $WORLD_SIZE_REPLACEMENTS == 1 && $DEFAULT_DIR_REPLACEMENTS == 1 && $OUTPUT_LOG_REPLACEMENTS == 1 ]] || {
      printf 'ERROR: expected one original world-size, default-local-dir, and output-log override; found %s, %s, %s\n' \
        "$WORLD_SIZE_REPLACEMENTS" "$DEFAULT_DIR_REPLACEMENTS" "$OUTPUT_LOG_REPLACEMENTS" >&2
      exit 1
    }
    for index in "${!RUN_ARGS[@]}"; do
      case ${RUN_ARGS[$index]} in
        trainer.n_gpus_per_node=8|trainer.default_local_dir="$PROJECT_PATH"/*-OPD|trainer.output_log_path="$PROJECT_PATH"/logs/terminal/*.log)
          unset 'RUN_ARGS[index]'
          ;;
      esac
    done
    RUN_ARGS=("${RUN_ARGS[@]}")
    RUN_ARGS+=(trainer.resume_mode=resume_path)
    RUN_ARGS+=(trainer.resume_from_path=$OPRD_RESUME_FROM_PATH)
    RUN_ARGS+=(trainer.default_local_dir=$OPRD_RESUME_LOCAL_DIR)
    RUN_ARGS+=(trainer.output_log_path=$OPRD_RESUME_TERMINAL_LOG)
    RUN_ARGS+=(trainer.total_training_steps=2239)
    RUN_ARGS+=(trainer.n_gpus_per_node=4)
    RUN_ARGS+=(trainer.max_actor_ckpt_to_keep=1)
    RUN_ARGS+=(hydra.run.dir=$OPRD_RESUME_HYDRA_DIR)
  elif [[ $EXPECTED_WORLD_SIZE != 8 ]]; then
    REPLACEMENTS=0
    RETENTION_OVERRIDES=0
    HYDRA_RUN_OVERRIDES=0
    for index in "${!RUN_ARGS[@]}"; do
      if [[ ${RUN_ARGS[$index]} == trainer.n_gpus_per_node=8 ]]; then
        RUN_ARGS[$index]=trainer.n_gpus_per_node=$EXPECTED_WORLD_SIZE
        REPLACEMENTS=$((REPLACEMENTS + 1))
      fi
      if [[ ${RUN_ARGS[$index]} == trainer.max_actor_ckpt_to_keep=* ]]; then
        RETENTION_OVERRIDES=$((RETENTION_OVERRIDES + 1))
      fi
      if [[ ${RUN_ARGS[$index]} == hydra.run.dir=* ]]; then
        HYDRA_RUN_OVERRIDES=$((HYDRA_RUN_OVERRIDES + 1))
      fi
    done
    [[ $REPLACEMENTS == 1 ]] || {
      printf 'ERROR: expected one trainer world-size override, found %s\n' "$REPLACEMENTS" >&2
      exit 1
    }
    [[ $RETENTION_OVERRIDES == 0 && $MAX_ACTOR_CKPTS == 1 ]] || {
      printf 'ERROR: checkpoint retention override is ambiguous\n' >&2
      exit 1
    }
    [[ $HYDRA_RUN_OVERRIDES == 0 && -n ${PROJECT_PATH:-} ]] || {
      printf 'ERROR: Hydra run directory override is ambiguous\n' >&2
      exit 1
    }
    RUN_ARGS+=(trainer.max_actor_ckpt_to_keep=$MAX_ACTOR_CKPTS)
    RUN_ARGS+=(hydra.run.dir=$PROJECT_PATH/hydra-run)
  fi
  [[ ! -e $OPRD_HYDRA_CAPTURE && ! -e $OPRD_ARGV_CAPTURE ]] || {
    printf 'ERROR: official Hydra capture path already exists\n' >&2
    exit 1
  }
  HYDRA_TEMP=$OPRD_HYDRA_CAPTURE.tmp.$$
  ARGV_TEMP=$OPRD_ARGV_CAPTURE.tmp.$$
  trap 'rm -f -- "$HYDRA_TEMP" "$ARGV_TEMP"' EXIT
  "$OPRD_REAL_PYTHON" "${RUN_ARGS[@]}" --cfg job --resolve > "$HYDRA_TEMP"
  "$OPRD_REAL_PYTHON" "$OPRD_CONTRACT_TOOL" --contract "$OPRD_CONTRACT" \
    validate-hydra --hydra "$HYDRA_TEMP" --official-root "$OPRD_OFFICIAL_ROOT" \
    --expected-world-size "$EXPECTED_WORLD_SIZE" "${HYDRA_EXECUTION_ARGS[@]}" \
    "${HYDRA_RESUME_ARGS[@]}" >/dev/null
  "$OPRD_REAL_PYTHON" - "$ARGV_TEMP" "${RUN_ARGS[@]}" <<'PY'
import json
import pathlib
import sys
pathlib.Path(sys.argv[1]).write_text(
    json.dumps(sys.argv[2:], ensure_ascii=False, separators=(",", ":")) + "\n",
    encoding="utf-8",
)
PY
  mv "$HYDRA_TEMP" "$OPRD_HYDRA_CAPTURE"
  mv "$ARGV_TEMP" "$OPRD_ARGV_CAPTURE"
  trap - EXIT
  set -- "${RUN_ARGS[@]}"
fi

exec "$OPRD_REAL_PYTHON" "$@"
