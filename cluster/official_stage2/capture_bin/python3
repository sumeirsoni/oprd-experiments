#!/bin/bash
set -euo pipefail

: "${OPRD_REAL_PYTHON:?OPRD_REAL_PYTHON is required}"

if [[ ${1:-} == -m && ${2:-} == verl.trainer.main_ppo ]]; then
  : "${OPRD_HYDRA_CAPTURE:?OPRD_HYDRA_CAPTURE is required}"
  : "${OPRD_ARGV_CAPTURE:?OPRD_ARGV_CAPTURE is required}"
  : "${OPRD_CONTRACT_TOOL:?OPRD_CONTRACT_TOOL is required}"
  : "${OPRD_CONTRACT:?OPRD_CONTRACT is required}"
  : "${OPRD_OFFICIAL_ROOT:?OPRD_OFFICIAL_ROOT is required}"
  EXPECTED_WORLD_SIZE=${OPRD_EXPECTED_WORLD_SIZE:-8}
  HYDRA_EXECUTION_ARGS=()
  MAX_ACTOR_CKPTS=
  if [[ -n ${OPRD_EXECUTION_DEVIATION:-} ]]; then
    EXECUTION_JSON=$(
      "$OPRD_REAL_PYTHON" "$OPRD_CONTRACT_TOOL" --contract "$OPRD_CONTRACT" \
        emit-execution --execution "$OPRD_EXECUTION_DEVIATION"
    )
    EXPECTED_WORLD_SIZE=$(
      "$OPRD_REAL_PYTHON" -c \
        'import json,sys; print(json.load(sys.stdin)["effective_topology"]["world_size"])' \
        <<< "$EXECUTION_JSON"
    )
    MAX_ACTOR_CKPTS=$(
      "$OPRD_REAL_PYTHON" -c \
        'import json,sys; print(json.load(sys.stdin)["checkpoint_policy"]["max_actor_checkpoints_to_keep"])' \
        <<< "$EXECUTION_JSON"
    )
    HYDRA_EXECUTION_ARGS=(--execution "$OPRD_EXECUTION_DEVIATION")
  fi
  [[ $EXPECTED_WORLD_SIZE == 4 || $EXPECTED_WORLD_SIZE == 8 ]] || {
    printf 'ERROR: OPRD_EXPECTED_WORLD_SIZE must be 4 or 8\n' >&2
    exit 1
  }
  RUN_ARGS=("$@")
  if [[ $EXPECTED_WORLD_SIZE != 8 ]]; then
    REPLACEMENTS=0
    RETENTION_OVERRIDES=0
    for index in "${!RUN_ARGS[@]}"; do
      if [[ ${RUN_ARGS[$index]} == trainer.n_gpus_per_node=8 ]]; then
        RUN_ARGS[$index]=trainer.n_gpus_per_node=$EXPECTED_WORLD_SIZE
        REPLACEMENTS=$((REPLACEMENTS + 1))
      fi
      if [[ ${RUN_ARGS[$index]} == trainer.max_actor_ckpt_to_keep=* ]]; then
        RETENTION_OVERRIDES=$((RETENTION_OVERRIDES + 1))
      fi
    done
    [[ $REPLACEMENTS == 1 ]] || {
      printf 'ERROR: expected one trainer world-size override, found %s\n' "$REPLACEMENTS" >&2
      exit 1
    }
    [[ $RETENTION_OVERRIDES == 0 && $MAX_ACTOR_CKPTS == 1 ]] || {
      printf 'ERROR: checkpoint retention override is ambiguous\n' >&2
      exit 1
    }
    RUN_ARGS+=(trainer.max_actor_ckpt_to_keep=$MAX_ACTOR_CKPTS)
  fi
  [[ ! -e $OPRD_HYDRA_CAPTURE && ! -e $OPRD_ARGV_CAPTURE ]] || {
    printf 'ERROR: official Hydra capture path already exists\n' >&2
    exit 1
  }
  HYDRA_TEMP=$OPRD_HYDRA_CAPTURE.tmp.$$
  ARGV_TEMP=$OPRD_ARGV_CAPTURE.tmp.$$
  trap 'rm -f -- "$HYDRA_TEMP" "$ARGV_TEMP"' EXIT
  "$OPRD_REAL_PYTHON" "${RUN_ARGS[@]}" --cfg job --resolve > "$HYDRA_TEMP"
  "$OPRD_REAL_PYTHON" "$OPRD_CONTRACT_TOOL" --contract "$OPRD_CONTRACT" \
    validate-hydra --hydra "$HYDRA_TEMP" --official-root "$OPRD_OFFICIAL_ROOT" \
    --expected-world-size "$EXPECTED_WORLD_SIZE" "${HYDRA_EXECUTION_ARGS[@]}" >/dev/null
  "$OPRD_REAL_PYTHON" - "$ARGV_TEMP" "${RUN_ARGS[@]}" <<'PY'
import json
import pathlib
import sys
pathlib.Path(sys.argv[1]).write_text(
    json.dumps(sys.argv[2:], ensure_ascii=False, separators=(",", ":")) + "\n",
    encoding="utf-8",
)
PY
  mv "$HYDRA_TEMP" "$OPRD_HYDRA_CAPTURE"
  mv "$ARGV_TEMP" "$OPRD_ARGV_CAPTURE"
  trap - EXIT
  set -- "${RUN_ARGS[@]}"
fi

exec "$OPRD_REAL_PYTHON" "$@"
